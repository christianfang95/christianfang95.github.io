# One-file pipeline: LPM coefficient vs. logit AME
# Run with: Rscript lpm_vs_logit_ame_pipeline.R

set.seed(20260513)

if (!requireNamespace("marginaleffects", quietly = TRUE)) {
  stop("Please install the marginaleffects package before running this script.")
}

library(marginaleffects)

# The installed marginaleffects version may expose avg_* rather than average_*.
# These aliases let the script use the function names requested in the paper.
if (!exists("average_comparisons")) {
  average_comparisons <- avg_comparisons
}
if (!exists("average_predictions")) {
  average_predictions <- avg_predictions
}

# -----------------------------
# 1. Simulation parameters
# -----------------------------

n <- 5000
skewed_x <- TRUE
run_monte_carlo <- TRUE
mc_reps <- 100
mc_results_file <- "mc_results_by_rep.csv"

# True coefficients in the data-generating process:
# P(Y = 1) = logit^{-1}(beta_0 + beta_x*x + beta_z*z + beta_xz*x*z)
beta_0 <- -1.5
beta_x <- 0.8
beta_z <- 0.7
beta_xz <- 0.5

# -----------------------------
# 2. Generate data
# -----------------------------

if (skewed_x) {
  x_raw <- rlnorm(n, meanlog = 0, sdlog = 0.9)
  x <- as.numeric(scale(log1p(x_raw)))
} else {
  x <- rnorm(n)
}

z <- rbinom(n, size = 1, prob = 0.4)

eta <- beta_0 + beta_x * x + beta_z * z + beta_xz * x * z
p_true <- plogis(eta)
y <- rbinom(n, size = 1, prob = p_true)

dat <- data.frame(y, x, z, eta, p_true)

# -----------------------------
# 3. Calculate the true AMEs
# -----------------------------

# Since this is a simulation, we know the true probability function.
# That is what makes a "true AME" possible.

# For continuous x, the true AME is the average derivative:
# dP(Y = 1)/dx = p * (1 - p) * d eta/dx
#              = p * (1 - p) * (beta_x + beta_xz*z)
true_ame_x <- mean(p_true * (1 - p_true) * (beta_x + beta_xz * z))

# For binary z, use the average counterfactual change from z = 0 to z = 1.
# This is a discrete change, not a derivative.
eta_z1 <- beta_0 + beta_x * x + beta_z * 1 + beta_xz * x * 1
eta_z0 <- beta_0 + beta_x * x + beta_z * 0 + beta_xz * x * 0
true_ame_z <- mean(plogis(eta_z1) - plogis(eta_z0))

# -----------------------------
# 4. Fit logit and calculate AMEs
# -----------------------------

logit_fit <- glm(y ~ x * z, data = dat, family = binomial(link = "logit"))
logit_b <- coef(logit_fit)

# Continuous x AME implied by the fitted logit model.
logit_ame_x_obj <- average_comparisons(
  logit_fit,
  variables = "x",
  comparison = "dydx",
  type = "response"
)
logit_ame_x <- logit_ame_x_obj$estimate[1]

# Binary z AME implied by the fitted logit model.
logit_ame_z_obj <- average_comparisons(
  logit_fit,
  variables = list(z = c(0, 1)),
  type = "response"
)
logit_ame_z <- logit_ame_z_obj$estimate[1]

# Average predicted probabilities from the fitted logit model.
logit_avg_prediction <- average_predictions(logit_fit, type = "response")
logit_avg_prediction_by_z <- average_predictions(
  logit_fit,
  newdata = datagrid(z = 0:1, grid_type = "counterfactual"),
  by = "z",
  type = "response"
)

# -----------------------------
# 5. Fit LPM and extract comparable quantities
# -----------------------------

lpm_fit <- lm(y ~ x * z, data = dat)
lpm_b <- coef(lpm_fit)
lpm_p_hat <- predict(lpm_fit)

# With an interaction, the LPM coefficient on x is the effect of x when z = 0.
# The average LPM slope for x is b_x + b_xz*mean(z).
lpm_avg_slope_x <- lpm_b[["x"]] + lpm_b[["x:z"]] * mean(z)

# For binary z, the average LPM discrete change is b_z + b_xz*mean(x).
lpm_avg_change_z <- lpm_b[["z"]] + lpm_b[["x:z"]] * mean(x)

# -----------------------------
# 6. Compare
# -----------------------------

data_summary <- data.frame(
  n = n,
  outcome_rate = mean(y),
  mean_true_probability = mean(p_true),
  min_true_probability = min(p_true),
  max_true_probability = max(p_true),
  share_lpm_predictions_below_0 = mean(lpm_p_hat < 0),
  share_lpm_predictions_above_1 = mean(lpm_p_hat > 1)
)

ame_comparison <- data.frame(
  estimand = c("true_ame", "logit_ame", "lpm_avg_slope_or_change"),
  x = c(true_ame_x, logit_ame_x, lpm_avg_slope_x),
  z = c(true_ame_z, logit_ame_z, lpm_avg_change_z)
)

cat("\nData summary\n")
print(data_summary, row.names = FALSE)

cat("\nAME comparison\n")
ame_comparison_print <- ame_comparison
ame_comparison_print$x <- round(ame_comparison_print$x, 4)
ame_comparison_print$z <- round(ame_comparison_print$z, 4)
print(ame_comparison_print, row.names = FALSE)

cat("\nRaw logit coefficients\n")
print(round(logit_b, 4))

cat("\nRaw LPM coefficients\n")
print(round(lpm_b, 4))

cat("\nAverage predicted probability from fitted logit\n")
print(logit_avg_prediction)

cat("\nCounterfactual average predicted probabilities from fitted logit\n")
print(logit_avg_prediction_by_z)

# -----------------------------
# 7. Optional mini Monte Carlo
# -----------------------------

if (run_monte_carlo) {
  mc_results <- vector("list", mc_reps)
  mc_data_summary <- vector("list", mc_reps)
  
  for (r in seq_len(mc_reps)) {
    if (skewed_x) {
      x_raw_r <- rlnorm(n, meanlog = 0, sdlog = 0.9)
      x_r <- as.numeric(scale(log1p(x_raw_r)))
    } else {
      x_r <- rnorm(n)
    }
    
    z_r <- rbinom(n, size = 1, prob = 0.4)
    eta_r <- beta_0 + beta_x * x_r + beta_z * z_r + beta_xz * x_r * z_r
    p_true_r <- plogis(eta_r)
    y_r <- rbinom(n, size = 1, prob = p_true_r)
    dat_r <- data.frame(y = y_r, x = x_r, z = z_r, p_true = p_true_r)
    
    true_x_r <- mean(p_true_r * (1 - p_true_r) * (beta_x + beta_xz * z_r))
    true_z_r <- mean(
      plogis(beta_0 + beta_x * x_r + beta_z + beta_xz * x_r) -
        plogis(beta_0 + beta_x * x_r)
    )
    
    logit_r <- glm(y ~ x * z, data = dat_r, family = binomial(link = "logit"))
    logit_x_r <- average_comparisons(
      logit_r,
      variables = "x",
      comparison = "dydx",
      type = "response"
    )$estimate[1]
    logit_z_r <- average_comparisons(
      logit_r,
      variables = list(z = c(0, 1)),
      type = "response"
    )$estimate[1]
    logit_pred_r <- average_predictions(logit_r, type = "response")$estimate[1]
    logit_pred_by_z_r <- average_predictions(
      logit_r,
      newdata = datagrid(z = 0:1, grid_type = "counterfactual"),
      by = "z",
      type = "response"
    )
    
    lpm_r <- lm(y ~ x * z, data = dat_r)
    lpm_b_r <- coef(lpm_r)
    lpm_p_r <- predict(lpm_r)
    lpm_x_r <- lpm_b_r[["x"]] + lpm_b_r[["x:z"]] * mean(z_r)
    lpm_z_r <- lpm_b_r[["z"]] + lpm_b_r[["x:z"]] * mean(x_r)
    
    mc_results[[r]] <- data.frame(
      rep = r,
      estimator = c("true_ame", "logit_ame", "lpm_avg_slope_or_change"),
      ame_x = c(true_x_r, logit_x_r, lpm_x_r),
      ame_z = c(true_z_r, logit_z_r, lpm_z_r)
    )
    
    mc_data_summary[[r]] <- data.frame(
      rep = r,
      outcome_rate = mean(y_r),
      mean_true_probability = mean(p_true_r),
      logit_avg_prediction = logit_pred_r,
      logit_avg_prediction_z0 = logit_pred_by_z_r$estimate[logit_pred_by_z_r$z == 0],
      logit_avg_prediction_z1 = logit_pred_by_z_r$estimate[logit_pred_by_z_r$z == 1],
      min_true_probability = min(p_true_r),
      max_true_probability = max(p_true_r),
      share_lpm_predictions_below_0 = mean(lpm_p_r < 0),
      share_lpm_predictions_above_1 = mean(lpm_p_r > 1)
    )
  }
  
  mc_results <- do.call(rbind, mc_results)
  mc_data_summary <- do.call(rbind, mc_data_summary)
  
  mc_results_long <- rbind(
    data.frame(
      rep = mc_results$rep,
      estimator = mc_results$estimator,
      variable = "x",
      estimate = mc_results$ame_x
    ),
    data.frame(
      rep = mc_results$rep,
      estimator = mc_results$estimator,
      variable = "z",
      estimate = mc_results$ame_z
    )
  )
  mc_results_long <- merge(mc_results_long, mc_data_summary, by = "rep")
  mc_results_long <- mc_results_long[
    order(mc_results_long$rep, mc_results_long$variable, mc_results_long$estimator),
  ]
  
  #write.csv(mc_results_long, mc_results_file, row.names = FALSE)
  
  cat("\nMonte Carlo results by replication: first 12 rows\n")
  print(head(mc_results_long, 12), row.names = FALSE)
  
  cat("\nSaved tidy Monte Carlo data to:", mc_results_file, "\n")
}
